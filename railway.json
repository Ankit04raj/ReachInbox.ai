{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 120,
    "preDeployCommand": "npm --workspace apps/backend exec -- prisma db push"
  }
}
