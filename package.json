{
  "name": "reachinbox-scheduler",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix apps/backend\" \"npm run dev --prefix apps/frontend\"",
    "build:backend": "cd apps/backend && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "cd apps/backend && npm start",
    "start:frontend": "cd apps/frontend && npx serve -s dist -l 3000",
    "start": "npm run start:backend",
    "test": "npm run test --prefix apps/backend",
    "lint": "npm run lint --prefix apps/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "serve": "^14.2.8"
  }
}
